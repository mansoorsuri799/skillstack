# App
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs must include:
#   {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/skillstack
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/skillstack

# Nodemailer / SMTP (Gmail app password, Resend SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM="SkillStack <your@email.com>"
# IMPORTANT for spam: EMAIL_FROM domain should match SMTP_USER / authenticated domain.
# Prefer a transactional provider (Resend, Postmark, Amazon SES) with SPF+DKIM+DMARC on skillstack.com.pk.
# Optional — where contact form briefs are delivered (defaults to hello@skillstack.com.pk)
# CONTACT_TO=hello@skillstack.com.pk

# Optional — Google Search Console HTML tag content value
# GOOGLE_SITE_VERIFICATION=your-gsc-verification-token

# Lemon Squeezy — international cards (https://app.lemonsqueezy.com/settings/api)
# Create 3 one-time products/variants matching Keyword / Growth / Full Stack prices.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_KEYWORDS=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_FULLSTACK=
# Webhook URL: https://skillstack.com.pk/api/webhooks/lemonsqueezy  (event: order_created)
LEMONSQUEEZY_WEBHOOK_SECRET=

# PayFast Pakistan — JazzCash / Easypaisa / local cards (https://gopayfast.com/)
# Token + hosted checkout URLs come from your merchant panel (sandbox vs live).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_NAME=
PAYFAST_SECURED_KEY=
PAYFAST_TOKEN_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/GetAccessToken
PAYFAST_CHECKOUT_URL=https://ipg1.apps.net.pk/Ecommerce/api/Transaction/PostTransaction
PAYFAST_GRANT_TYPE=client_credentials
# PKR charged = USD plan price × this rate (override per-plan via pricePkr in code if needed)
PAYFAST_USD_TO_PKR=280
# Optional — same rate for client-side ~₨ display on pricing buttons
# NEXT_PUBLIC_PAYFAST_USD_TO_PKR=280

# Optional — Stripe (not available for PK merchant accounts; keep for legacy/test)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
