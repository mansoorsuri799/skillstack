# App
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs must include:
#   {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/skillstack
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/skillstack

# Nodemailer / SMTP (Gmail app password, Resend SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM="SkillStack <your@email.com>"

# Stripe (https://dashboard.stripe.com/apikeys — use test keys first)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
