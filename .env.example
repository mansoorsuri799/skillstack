# App
AUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/skillstack
# Or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/skillstack

# Nodemailer / SMTP (Gmail app password, Resend SMTP, Mailtrap, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM="SkillStack <your@email.com>"
